@model List<Test1._1.Models.ViewModels.CompanyViewModel>
@{
    ViewBag.Title = "Dashboard";
    Layout = null;

}


<link rel="stylesheet" href="~/css/styleAdmin.css" />

<script src="~/js/indexAdmin.js"></script>


<nav class="navbar">
    <div class="logo">
        <i class="fa-solid fa-font-awesome"></i>
        <a asp-controller="Admin" asp-action="Dashboard">jobify</a>
    </div>
    <div class="menu">
        <div class="menu-links">
            @if (ViewBag.StatusTitle == "Accepted Companies")
            {
                <a href="#nacc">Companies Accept</a>
            }
            else
            {
                <a asp-controller="Admin" asp-action="CompaniesAccept">Companies Accept</a>
                
            }
            @if (ViewBag.StatusTitle == "Rejected Companies")
            {
                <a href="#nacc">Companies Reject</a>
            }
            else
            {
                <a asp-controller="Admin" asp-action="CompaniesReject">Companies Reject</a>

            }
            
            @if (ViewBag.StatusTitle == "Pending Companies")
            {
                <a href="#nacc">Companies Pending</a>
            }
            else
            {
                <a asp-controller="Admin" asp-action="CompaniesPending">Companies Pending</a>

            }
            
            <a href="#Modify_ads">Modify ads</a>
            <a href="#Payment">Payment</a>
        </div>
    </div>
    <div class="menu-btn">
        <i class="fa-solid fa-bars"></i>
    </div>
</nav>
<div style="height: 100px;"></div>
<br>
