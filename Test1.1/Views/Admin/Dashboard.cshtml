<!-- ***************************************************payment******************************************************************** -->

<div class="subscription-container">
    <div class="subscription-box">
        <h3>Daily Subscription</h3>
        <p class="price">$10</p>
        <button class="edit-btn">Edit</button>
    </div>
    <div class="subscription-box">
        <h3>Weekly Subscription</h3>
        <p class="price">$20</p>
        <button class="edit-btn">Edit</button>
    </div>
    <div class="subscription-box">
        <h3>Monthly Subscription</h3>
        <p class="price">$30</p>
        <button class="edit-btn">Edit</button>
    </div>
    <div class="subscription-box">
        <h3>Yearly Subscription</h3>
        <p class="price">$40</p>
        <button class="edit-btn">Edit</button>
    </div>
</div>

<!-- Edit Modal -->
<div id="edit-modal" class="modal">
    <div class="modal-content">
        <span class="close-button">&times;</span>
        <h4 id="modal-title">Edit Subscription</h4>
        <div class="modal-body">
            <p id="subscription-name">Subscription Name</p>
            <div class="price-row">
                <span class="old-price">$0</span>
                <input type="text" id="new-price-input" placeholder="New Price" />
            </div>
            <button id="confirm-edit-btn">Confirm</button>
        </div>
    </div>
</div>

<section id="Payment">
</section>

<script src="~/js/indexAdmin.js"></script>

