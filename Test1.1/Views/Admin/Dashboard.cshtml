@foreach (var company in companiesToShow)
{

    <section class="company-requests" id="nacc">
        <div class="company-box">
        <a asp-controller="Admin" asp-action="CompanyCheckout" asp-route-id="@company.Id" class="company-link">
                <img src="@Url.Content("~/" + company.Logo)" alt="Company Logo" class="company-logo" />
        </a>

            <a asp-controller="Admin" asp-action="CompanyCheckout" asp-route-id="@company.Id" class="company-link company-name">
                
            @company.UserName
        </a>
        </div>
    </section>
}
@if (totalCompanies > maxToShow)
{
    <div style="text-align:center; margin-top: 20px;" class="action-buttons">
        <form asp-controller="Admin" asp-action="CompaniesPending" method="get">
            <button type="submit" class="btn btn-primary details-btn">Show More</button>
        </form>
    </div>
}



