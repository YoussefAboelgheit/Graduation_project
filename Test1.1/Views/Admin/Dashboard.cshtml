@model Test1._1.Models.ViewModels.AdminDashboardViewModel
@using Test1._1.Models.Entity
@using Microsoft.EntityFrameworkCore
@inject AppDBContext _context
@{
    ViewBag.Title = "Dashboard";
    Layout = null;
    var totalCompanies = Model.Companies.Count;
    var maxToShow = 5;
    var companiesToShow = Model.Companies.Take(maxToShow).ToList();
}


<link rel="stylesheet" href="~/css/styleAdmin.css" />


<nav class="navbar">
    <div class="logo">
        <i class="fa-solid fa-font-awesome"></i>
        <a href="@Url.Action("Index", "Home")" style="text-decoration: none; color: inherit;">jobify</a>
    </div>
    <div class="menu">
        <div class="menu-links">
            <a asp-controller="Admin" asp-action="CompaniesAccept">Companies Accept</a>
            <a asp-controller="Admin" asp-action="CompaniesReject"> Companies Reject</a>
            <a asp-controller="Admin" asp-action="CompaniesPending">Companies Pending</a>
            <a href="#Pending_ads">Pending ads</a>
            <a href="#Payment">Subscription</a>
        </div>
        <span class="welcome-admin">
        <style="color: inherit; text-decoration: none;">
            Welcome, @User.Identity.Name
        </span>
        <form asp-controller="Home" asp-action="Logout" method="post">
            <button type="submit" class="log_out">Log out</button>
        </form>
    </div>
    <div class="menu-btn">
        <i class="fa-solid fa-bars"></i>
    </div>
</nav>

<div style="height: 100px;"></div>
<br>
<br>
<br>



<!-- ***************************************************acc******************************************************************** -->

@foreach (var company in companiesToShow)
{

    <section class="company-requests" id="nacc">
        <div class="company-box">
        <a asp-controller="Admin" asp-action="CompanyCheckout" asp-route-id="@company.Id" class="company-link">
                <img src="@Url.Content("~/" + company.Logo)" alt="Company Logo" class="company-logo" />
        </a>

            <a asp-controller="Admin" asp-action="CompanyCheckout" asp-route-id="@company.Id" class="company-link company-name">
                
            @company.UserName
        </a>
        </div>
    </section>
}
@if (totalCompanies > maxToShow)
{
    <div style="text-align:center; margin-top: 20px;" class="action-buttons">
        <form asp-controller="Admin" asp-action="CompaniesPending" method="get">
            <button type="submit" class="btn btn-primary details-btn">Show More</button>
        </form>
    </div>
}



<!-- ***************************************************end acc******************************************************************** -->
<br>
<br>
<br>
<br>
<br>
<br>
<br>
<br>
<hr>
<br>
<br>
<br>
<br>
<br>
<br>

<!-- ***************************************************ads******************************************************************** -->
<section class="Pending_ads" id="Pending_ads">
    <h2 style="text-align: center; color: #162447; font-size: 24px; margin-bottom: 30px; font-weight: bold;">Pending Advertisement Edits</h2>

    @if (Model.PendingEdits != null && Model.PendingEdits.Any())
    {
        foreach (var edit in Model.PendingEdits)
        {
            var company = await _context.Companies
            .FirstOrDefaultAsync(c => c.Id == edit.JobAdvertisment.CompanyId);

            <div class="edit-comparison-box">
            <div class="ad-box">
            <div class="ad old-ad">
                <div class="ad-image">
                            @if (company != null && !string.IsNullOrEmpty(company.Logo))
                            {
                                <img src="~/@company.Logo" alt="Company Logo" />
                            }
                            else
                            {
                                <img src="~/pic/placeholder.jpg" alt="Default Logo" />
                            }
                </div>
                <div class="ad-content">
                            <h3 class="company-name">@(company?.UserName ?? "Unknown Company")</h3>
                            <div class="ad-details">
                                <p><strong>Job Title:</strong> @edit.JobAdvertisment.jobtitle</p>
                                <p><strong>Salary:</strong> @edit.JobAdvertisment.salary</p>
                                <p><strong>Location:</strong> @edit.JobAdvertisment.governorate</p>
                                <p><strong>Job Time:</strong> @edit.JobAdvertisment.Job_time</p>
                                <p><strong>Requirements:</strong> @edit.JobAdvertisment.JobRequirements</p>
                                <p><strong>Description:</strong> @edit.JobAdvertisment.Jobdetail</p>
                </div>
            </div>
        </div>
                </div>

        <div class="ad-box">
            <div class="ad new-ad">
                        <div class="new-label">New</div>
                <div class="ad-image">
                            @if (company != null && !string.IsNullOrEmpty(company.Logo))
                            {
                                <img src="~/@company.Logo" alt="Company Logo" />
                            }
                            else
                            {
                                <img src="~/pic/placeholder.jpg" alt="Default Logo" />
                            }
                </div>
                <div class="ad-content">
                            <h3 class="company-name">@(company?.UserName ?? "Unknown Company")</h3>
                            <div class="ad-details">
                                <p><strong>Job Title:</strong> @edit.JobTitle</p>
                                <p><strong>Salary:</strong> @edit.Salary</p>
                                <p><strong>Location:</strong> @edit.Governorate</p>
                                <p><strong>Job Time:</strong> @edit.JobTime</p>
                                <p><strong>Requirements:</strong> @edit.JobRequirements</p>
                                <p><strong>Description:</strong> @edit.JobDetail</p>
                            </div>
                </div>
            </div>
        </div>

        <div class="comparison-actions">
                    <form asp-action="ApproveEdit" asp-route-editId="@edit.Id" method="post" style="display:inline;">
                        <button type="submit" class="accept-btn">Approve</button>
                    </form>
                    <form asp-action="RejectEdit" asp-route-editId="@edit.Id" method="post" style="display:inline;">
                        <button type="submit" class="reject-btn">Reject</button>
                    </form>
        </div>
    </div>
        }
    }
    else
    {
        <p style="text-align:center; padding:20px; color:gray;">No pending edits at the moment.</p>
    }
</section>

<!-- ***************************************************end ads******************************************************************** -->
