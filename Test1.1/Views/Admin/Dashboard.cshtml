@model Test1._1.Models.ViewModels.AdminDashboardViewModel

@{
    ViewBag.Title = "Dashboard";
    Layout = null;
}

<link rel="stylesheet" href="~/css/styleAdmin.css" />
<script src="~/js/indexAdmin.js"></script>

<nav class="navbar">
    <div class="logo">
        <i class="fa-solid fa-font-awesome"></i>
        <a href="#">Jobify</a>
    </div>
    <div class="menu">
        <div class="menu-links">
            <a href="#nacc">New Company Account</a>
            <a href="#Modify_ads">Modify Ads</a>
            <a href="#CompanySubscraptions">Company Subscriptions</a>
            <a href="#ApplicantSubscraptions">Applicant Subscriptions</a>
            <a href="#ConfirmSubscriptions">Confirm Subscriptions</a>
        </div>
    </div>
    <div class="menu-btn">
        <i class="fa-solid fa-bars"></i>
    </div>
</nav>

<div style="height: 100px;"></div>
<br>
<br>
<br>

<!-- Company Requests Section -->
<section class="company-requests" id="nacc">
    @if (Model.Companies != null && Model.Companies.Any())
    {
        foreach (var company in Model.Companies)
        {
            <div class="company-box">
                <div class="company-info">
                    <a href="#" class="company-link">
                        <img src="~/@company.Logo" alt="Company Logo" class="company-logo" />
                    </a>

                    <div class="company-details">
                        <p><strong>Username:</strong> @company.UserName</p>
                        <p><strong>Field of Work:</strong> @company.FiledWork</p>
                        <p><strong>Number of Employees:</strong> @company.CurrentNumEmployees</p>
                        <p><strong>Description:</strong> @company.Description</p>
                        <p><strong>Tax Card:</strong> <a href='@Url.Content("~/" + company.TaxCard.Replace("\\", "/"))' target="_blank">View PDF</a></p>
                        <p><strong>Commercial Register:</strong> <a href='@Url.Content("~/" + company.CommercialRegister.Replace("\\", "/"))' target="_blank">View PDF</a></p>
                    </div>
                </div>

                <div class="action-buttons">
                    <form asp-action="RejectCompany" asp-route-id="@company.Id" method="post" style="display:inline;">
                        <button type="submit" class="reject-btn">Reject</button>
                    </form>
                    <form asp-action="AcceptCompany" asp-route-id="@company.Id" method="post" style="display:inline;">
                        <button type="submit" class="accept-btn">Accept</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <p style="text-align:center; padding:20px; color:gray;">No pending companies at the moment.</p>
    }
</section>

<br>
