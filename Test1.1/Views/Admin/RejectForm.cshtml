@model Test1._1.Models.ViewModels.RejectCompanyViewModel

@{
    ViewBag.Title = "Reject Company";
    Layout = null;
}
<link rel="stylesheet" href="~/css/rejectForm.css" />
<h2>Reject @Model.CompanyName</h2>

<form asp-controller="Admin" asp-action="RejectForm" method="post">
    <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
    <input type="hidden" name="CompanyEmail" value="@Model.CompanyEmail" />
    <input type="hidden" name="CompanyName" value="@Model.CompanyName" />

    <label for="ReportMessage">Rejection Reason:</label><br/>
    <textarea name="ReportMessage" rows="5" cols="50" required></textarea><br /><br />

    <button type="submit" class="btn btn-danger">Send & Reject</button>
</form>
