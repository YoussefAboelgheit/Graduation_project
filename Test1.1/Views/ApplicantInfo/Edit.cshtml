@model Test1._1.Models.ViewModels.ApplicantEditViewModel

@{
    ViewData["Title"] = "Edit Applicant";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4">
        <h2>Edit Applicant</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <ul class="mb-0">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <!-- Hidden fields to store original values -->
            <input type="hidden" asp-for="OriginalUserName" />
            <input type="hidden" asp-for="OriginalLastName" />
            <input type="hidden" asp-for="OriginalPhoneNumber" />
            <input type="hidden" asp-for="OriginalEmail" />
            <input type="hidden" asp-for="OriginalField_work" />
            <input type="hidden" asp-for="OriginalYears_experience" />
            <input type="hidden" asp-for="OriginalAddress" />
            <input type="hidden" asp-for="CurrentCV" />
            <input type="hidden" asp-for="CurrentProfileImage" />

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">First Name</label>
                        <input asp-for="UserName" class="form-control" placeholder="Leave blank to keep unchanged" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="lastName" class="form-label">Last Name</label>
                        <input asp-for="lastName" class="form-control" placeholder="Leave blank to keep unchanged" />
                        <span asp-validation-for="lastName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Leave blank to keep unchanged" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        <div class="form-text">Format: 01xxxxxxxxx (11 digits starting with 01)</div>
                    </div>

                    @*<div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="Leave blank to keep unchanged" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <div class="form-text">Only Gmail and Hotmail addresses are accepted</div>
                    </div>*@

                    <div class="mb-3">
                        <label asp-for="Field_work" class="form-label">Field of Work</label>
                        <select asp-for="Field_work" id="FieldWorkSelect" class="form-control scrollable">
                            <option value="">Select Field of Work</option>
                            <option>Software Engineer</option>
                            <option>Front‑End Developer</option>
                            <option>Back‑End Developer</option>
                            <option>Full Stack Developer</option>
                            <option>Mobile App Developer</option>
                            <option>DevOps Engineer</option>
                            <option>QA/Test Engineer</option>
                            <option>UI/UX Designer</option>
                            <option>Data Analyst</option>
                            <option>Data Scientist</option>
                            <option>Machine Learning Engineer</option>
                            <option>Cybersecurity Specialist</option>
                            <option>Cloud Engineer</option>
                            <option>Game Developer</option>
                            <option>IT Support Specialist</option>
                            <option>System Administrator</option>
                            <option>Network Engineer</option>
                            <option>Embedded Systems Engineer</option>
                            <option>AI Engineer</option>
                            <option>Blockchain Developer</option>
                            <option>Technical Writer</option>
                            <option>IT Project Manager</option>
                            <option>Database Administrator</option>
                            <option>AR/VR Developer</option>
                            <option>Other</option>
                        </select>
                        <span asp-validation-for="Field_work" class="text-danger"></span>

                        <!-- Other field input - hidden by default -->
                        <input type="text"
                               id="FieldWorkOther"
                               name="Field_work_other"
                               class="form-control mt-2"
                               placeholder="Please specify your field of work"
                               style="display: none;" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Years_experience" class="form-label">Years of Experience</label>
                        <input asp-for="Years_experience" class="form-control" type="number" min="0" placeholder="Leave blank to keep unchanged" />
                        <span asp-validation-for="Years_experience" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="address">City:</label>
                        <select asp-for="address" id="AddressSelect" class="form-control scrollable" required>
                            <br>
                            <option value="Alexandria">Alexandria</option>
                            <option value="Assiut">Assiut</option>
                            <option value="Aswan">Aswan</option>
                            <option value="Beheira">Beheira</option>
                            <option value="Beni Suef">Beni Suef</option>
                            <option value="Cairo">Cairo</option>
                            <option value="Dakahlia">Dakahlia</option>
                            <option value="Damietta">Damietta</option>
                            <option value="Fayoum">Fayoum</option>
                            <option value="Gharbia">Gharbia</option>
                            <option value="Giza">Giza</option>
                            <option value="Ismailia">Ismailia</option>
                            <option value="Kafr El Sheikh">Kafr El Sheikh</option>
                            <option value="Luxor">Luxor</option>
                            <option value="Matrouh">Matrouh</option>
                            <option value="Minya">Minya</option>
                            <option value="Monufia">Monufia</option>
                            <option value="New Valley">New Valley</option>
                            <option value="North Sinai">North Sinai</option>
                            <option value="Port Said">Port Said</option>
                            <option value="Qalyubia">Qalyubia</option>
                            <option value="Qena">Qena</option>
                            <option value="Red Sea">Red Sea</option>
                            <option value="Sharqia">Sharqia</option>
                            <option value="Sohag">Sohag</option>
                            <option value="South Sinai">South Sinai</option>
                            <option value="Suez">Suez</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">New Password</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="Leave blank to keep current password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <div class="form-text">Password must be at least 8 characters with uppercase, lowercase, and number</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Confirm new password if changing" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CVFile" class="form-label">Upload New CV</label>
                        <input asp-for="CVFile" class="form-control" type="file" accept=".pdf,.jpg,.jpeg,.png" />
                        <span asp-validation-for="CVFile" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProfileImage" class="form-label">Upload New Profile Image</label>
                        <input asp-for="ProfileImage" class="form-control" type="file" accept=".jpg,.jpeg,.png" />
                        <span asp-validation-for="ProfileImage" class="text-danger"></span>
                        @if (!string.IsNullOrEmpty(Model.CurrentProfileImage))
                        {
                            <div class="mt-2">
                                <div class="form-text">Current Profile Image:</div>
                                <img src="~/@Model.CurrentProfileImage" alt="Current Profile" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;" class="mt-1" />
                            </div>
                        }
                        else
                        {
                            <div class="form-text">No profile image currently uploaded</div>
                        }
                    </div>
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <button type="submit" class="btn btn-success btn-lg">Save Changes</button>
                    <a asp-action="Index" asp-route-id="@Model.Id" class="btn btn-secondary btn-lg ms-2">Cancel</a>
                </div>
            </div>

            <div class="alert alert-info mt-3">
                <strong>Note:</strong> All fields are optional. Only the fields you fill out will be updated. Leave fields blank to keep their current values.
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const select = document.getElementById('FieldWorkSelect');
            const otherInput = document.getElementById('FieldWorkOther');

            // Show/hide other input based on selection
            select.addEventListener('change', () => {
                if (select.value === 'Other') {
                    otherInput.style.display = 'block';
                    otherInput.required = true; // Required when "Other" is selected
                } else {
                    otherInput.style.display = 'none';
                    otherInput.required = false;
                    otherInput.value = '';
                }
            });

            // Handle form submission for the edit form
            const editForm = document.querySelector('form[asp-action="Edit"]');
            if (editForm) {
                editForm.addEventListener('submit', (e) => {
                    if (select.value === 'Other') {
                        const customValue = otherInput.value.trim();

                        if (customValue === '') {
                            e.preventDefault();
                            alert('Please specify your field of work.');
                            otherInput.focus();
                            return false;
                        }

                        // Create a new option with the custom value and select it
                        const customOption = document.createElement('option');
                        customOption.value = customValue;
                        customOption.text = customValue;
                        customOption.selected = true;

                        // Clear the select and add the custom option
                        select.innerHTML = '';
                        select.appendChild(customOption);

                        // Ensure the select is enabled for submission
                        select.disabled = false;

                        // Update the select value to ensure it's properly set
                        select.value = customValue;
                    }
                });
            }
        });
    </script>
</body>
</html>