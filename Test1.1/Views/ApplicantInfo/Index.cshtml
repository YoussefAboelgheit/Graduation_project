@model Test1._1.Models.Entity.Applicant
@{
    ViewData["Title"] = "Applicant Profile";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/styleApplicantProfile.css" />

</head>
<body>

    <header class="navbar">
        <div class="navbar-left">
            <a href="@Url.Action("Index", "Home")" style="text-decoration: none; color: inherit;">
            <img src="~/uploads/JobifyLogo.jpg" alt="Jobify Logo" class="logo" />
            <span class="site-name">Jobify</span>
            </a>
        </div>
        <div class="navbar-right">
            <nav class="nav-links">
                <a href="#Advertisements">Advertisements</a>
                <a href="#payment">Payment</a>
            </nav>
            <div class="user-info">
                <img src="~/@Model.Profile_image" alt="User Photo" class="user-photo" />
                <span class="user-name" style="color: #ec0027; font-size: larger; font-weight: 800;">
                    @Model.UserName @Model.lastName
                </span>
            </div>
            <a href="@Url.Action("Edit", "ApplicantInfo", new { id = Model.Id })" id="editBtn" class="edit-btn" title="Edit Profile">&#9998;</a>
        </div>
    </header>

    <!-- ========================= Profile Details ========================= -->
    <br />
    <br />
    <br />
    <br />
    <br />
    <div class="profile-container">
        <div class="profile-image">
            <img src="~/@Model.Profile_image" alt="Applicant Photo" />
        </div>
        <div class="profile-details">
            <p><strong>Name:</strong> @Model.UserName @Model.lastName</p><br />
            <p><strong>Field of Work:</strong> @Model.Field_work</p><br />
            <p><strong>Years of Experience:</strong> @Model.Years_experience</p><br />
            <p><strong>Email:</strong> @Model.Email</p><br />
            <p><strong>Phone:</strong> @Model.PhoneNumber</p><br />
            <p><strong>Address:</strong> @Model.address</p><br />
            <p>
                <strong>CV:</strong>
                @if (string.IsNullOrEmpty(Model.CV))
                {
                    <span>No CV uploaded</span>
                }
                else
                {
                    <a href="@Url.Action("ViewCV", "ApplicantInfo", new { id = Model.Id })" target="_blank">View CV</a>
                }
            </p>
        </div>
    </div>

    <!-- ============================ Advertisements ============================ -->
    <h2 id="Advertisements">Advertisements</h2>
    <div class="ads-container">
        @for (int i = 0; i < 3; i++)
        {
            <div class="ad">
                <div class="ad-image">
                    @*<img src="~/pic/فلسطين2 .jpg" alt="Company Logo">*@
                </div>
                <div class="ad-content">
                    <h3 class="company-name">Mza.company</h3>
                    <p class="ad-details">Lorem ipsum dolor sit amet consectetur adipisicing elit...</p>
                    <button class="details-btn">View More Details</button>
                </div>
            </div>
        }
    </div>

    <!-- Payment Section -->
    <h2 id="payment">Payment</h2>

    <script src="~/js/indexApplicantInfo.js" asp-append-version="true"></script>

</body>
</html>