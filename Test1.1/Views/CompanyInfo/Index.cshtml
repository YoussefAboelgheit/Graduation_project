@model Test1._1.Models.Entity.Company
@{
    ViewData["Title"] = "Company Profile";
    Layout = null;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Company Profile</title>
    <link rel="stylesheet" href="~/css/styleCompanyProfile.css">
    <link rel="stylesheet" href="~/css/font/home_index_all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <header class="navbar">
        <div class="navbar-left">
            <a href="@Url.Action("Index", "Home")" style="text-decoration: none; color: inherit;">
                <img src="~/uploads/JobifyLogo.jpg" alt="Jobify Logo" class="logo">
                <span class="site-name">Jobify</span>
            </a>
        </div>
        <div class="navbar-right">
            <nav class="nav-links">
                <a href="#old_advs">Advertisements</a>
                <a href="#Payment">Payment</a>

            </nav>
            <div class="company-info">
                @if (Model.Id == currentUserId)
                {
                    <img src="~/@Model.Logo" alt="User Photo" class="user-photo" />
                }
                <span class="company-name" style="color: #ec0027; font-size: larger;
        font-weight: 800;">@Model.UserName</span>
            </div>
            @if (Model.Id == currentUserId)
            {
                <a href="@Url.Action("Edit", "CompanyInfo", new { id = Model.Id })" id="editBtn" class="edit-btn" title="Edit Profile">&#9998;</a>
            }
        </div>

    </header>

    <!-- ========================= Company Details  ========================= -->
    <br>
    <br>
    <br>
    <br>
    <br>
    <div class="profile-container">
        <div class="profile-image">
            <img src="~/@Model.Logo" alt="Company Photo">
        </div>
        <div class="profile-details">
            <p><strong>Username:</strong> @Model.UserName</p><br>
            <p><strong>Field of Work:</strong> @Model.FiledWork</p><br />
            <p><strong>Email:</strong> @Model.Email</p><br>
            <p><strong>Address:</strong> @Model.address</p><br>
            <p><strong>Phone:</strong> @Model.PhoneNumber</p><br>
            <p><strong>Description:</strong> @Model.Description</p><br>
        </div>
    </div>

    <!-- ===========================================old advertisements================================================== -->
    <h2 id="old_advs">Published Advertisements</h2>
    <div class="ads-container">
        @if (Model.JobAdvertisments != null && Model.JobAdvertisments.Any())
        {
            @foreach (var ad in Model.JobAdvertisments.OrderByDescending(a => a.CreatedDate))
            {
                <div class="ad">
                    <div class="ad-image">
                        <img src="~/@Model.Logo" alt="@Model.UserName Logo">
                    </div>
                    <div class="ad-content">
                        <h3 class="company-name">@Model.UserName</h3>
                        <p class="ad-details">
                            <strong>Field of work:</strong> @ad.jobtitle <br />
                            <strong>Salary:</strong> @ad.salary EGP<br>
                            <strong>Location:</strong> @ad.governorate<br>
                            <strong>Time:</strong> @ad.Job_time<br>
                        </p>
                        <a href="@Url.Action("Details", "JobAdvertisement", new { id = ad.Id })" class="details-btn">View More Details</a>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="text-align: center; color: #ccc; font-style: italic;">No advertisements published yet.</p>
        }
    </div>

    <br>
    <br>
    <br>
    <br>
    @if (Model.Id == currentUserId)
    {
        <div class="button-wrapper">
            <a href="@Url.Action("Create", "JobAdvertisement", new { companyId = Model.Id })"
               class="Create_New_Advertisements"
               style="display: inline-block; text-decoration: none; text-align: center; line-height: normal;">
                Create New Advertisements
            </a>
        </div>
    }

    <style>
        .button-wrapper {
            display: flex;
            align-items: center; /* Vertically center the link */
            height: 100px; /* Adjust to match your layout */
        }
    </style>

    <!-- ===========================================payment================================================== -->
    <h2 id="Payment">Payment</h2>
    <script src="~/js/indexCompanyInfo.js"></script>
</body>
</html>