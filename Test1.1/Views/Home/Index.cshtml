<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="~/css/home_style_index.css">
    <link rel="stylesheet" href="~/css/font/home_index_all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">
            <i class="fa-solid fa-font-awesome"></i>
            <a href="#">jobify</a>
        </div>
        <div class="menu">
            <div class="menu-links">
                <a href="/Search/Index">Search</a>
                <a href="#Sections">Sections</a>
                <a href="#Applicants">Applicants</a>
                <a href="#Advertisements">Advertisements</a>
                <a href="#Contact_us">Contact us</a>
            </div>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="welcome-text">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller= "Admin"
                           asp-action="Dashboard"
                           style="color: inherit; text-decoration: none;">
                            Welcome, @User.Identity.Name
                        </a>
                    }
                    else
                    {
                        string typeOfUser = "CompanyInfo";
                        if (User.IsInRole("Applicant"))
                        {
                            typeOfUser = "ApplicantInfo";
                        }
                        <a asp-controller="@typeOfUser"
                           asp-action="Index"
                           asp-route-id="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)"
                           style="color: inherit; text-decoration: none;">
                        Welcome, @User.Identity.Name
                        </a>
                    }
                </span>
                <form asp-controller="Home" asp-action="Logout" method="post">
                    <button type="submit" class="sign_up">Log out</button>
                </form>
            }
            else
            {
                <a asp-controller="Home" asp-action="SignIn" class="btn log-in">Log in</a>
                <a asp-controller="Home" asp-action="SignUp" class="btn sign_up">Sign up</a>
            }

        </div>
        <div class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </div>
    </nav>


    <!-- -----------------------search------------------------------ -->
  
    <div class="search" id="ssssearch">
       <div class="box">
          <input type="text" id="searchInput" placeholder="Search...">
          <a href="#"><i class="fa-solid fa-magnifying-glass"></i></a>
          <div id="suggestions" class="suggestion-box"></div>
       </div>
    </div>
    <!-- ------------------------------------التقسيمه--------------------------------- -->
    <h2 id="Sections"> Sections</h2>
    <div class="job-sec">
        <a href="#" class="job-item">
            <i class="fas fa-palette"></i>
            <span>UI/UX Designer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-laptop-code"></i>
            <span>Front-End Developer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-server"></i>
            <span>Back-End Developer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-cogs"></i>
            <span>Software Engineer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-chart-bar"></i>
            <span>Data Analyst</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-robot"></i>
            <span>Machine Learning Engineer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-brain"></i>
            <span>AI Engineer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-ellipsis-h"></i>
            <span>Others</span>
        </a>
    </div>
    <!-- ---------------------------suggestions------------------------------------------ -->
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        @if (User.IsInRole("Company") && Model.CompanySuggestions != null && Model.CompanySuggestions.Any())
        {
            <h2 id="Sections">
                Suggested Applicants
            </h2>
            <div class="applicant" id="Applicants">
                @foreach (var applicant in Model.CompanySuggestions)
                {
                    <partial name="_ApplicantCard" model="applicant" />
                }
            </div>
        }
        else if (User.IsInRole("Applicant") && Model.ApplicantSuggestions != null && Model.ApplicantSuggestions.Any())
        {
            <h2 id="Sections">
                Suggested Job Ads
            </h2>
            <div class="ads-container">
                @foreach (var company in Model.ApplicantSuggestions)
                {
                    <partial name="_CompanyAd" model="company" />
                }
            </div>
        }
    }

    
