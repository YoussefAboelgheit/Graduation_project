<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="~/css/home_style_index.css">
    <link rel="stylesheet" href="~/css/font/home_index_all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <div class="logo">
            <i class="fa-solid fa-font-awesome"></i>
            <a href="#">jobify</a>
        </div>
        <div class="menu">
            <div class="menu-links">
                <a href="#ssssearch">Search</a>
                <a href="#Sections">Sections</a>
                <a href="#Applicants">Applicants</a>
                <a href="#Advertisements">Advertisements</a>
                <a href="#Contact_us">Contact us</a>
            </div>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <span class="welcome-text">Welcome, @User.Identity.Name</span>
                <form asp-controller="Home" asp-action="Logout" method="post">
                    <button type="submit" class="btn">Logout</button>
                </form>
            }
            else
            {
                <a asp-controller="Home" asp-action="SignIn" class="btn log-in">Log In</a>
                <a asp-controller="Home" asp-action="SignUp" class="btn sign_up">SignUp</a>
            }

        </div>
        <div class="menu-btn">
            <i class="fa-solid fa-bars"></i>
        </div>
    </nav>


    <!-- -----------------------search------------------------------ -->
    <div class="search" id="ssssearch">
        <div class="box">
            <input type="text" name=" " id="" placeholder="Search...">
            <a href="">
                <i class="fa-solid fa-magnifying-glass"></i>
            </a>
        </div>
    </div>
    <!-- ------------------------------------التقسيمه--------------------------------- -->
    <h2 id="Sections"> Sections</h2>
    <div class="job-sec">
        <a href="#" class="job-item">
            <i class="fas fa-palette"></i>
            <span>UI/UX Designer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-laptop-code"></i>
            <span>Front-End Developer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-server"></i>
            <span>Back-End Developer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-cogs"></i>
            <span>Software Engineer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-chart-bar"></i>
            <span>Data Analyst</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-robot"></i>
            <span>Machine Learning Engineer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-brain"></i>
            <span>AI Engineer</span>
        </a>
        <a href="#" class="job-item">
            <i class="fas fa-ellipsis-h"></i>
            <span>Others</span>
        </a>
    </div>



    <!-- ---------------------------APPPPPPPPPPPPPPPPPPPPPPPP------------------------------------------ -->
    <div class="filter-container">
        <div class="filter-header">
            <span class="section-title">Applicants</span>
            <div class="filters">
                <div class="filter-item">
                    <label for="governorate-app">City:</label>
                    <select id="governorate-app">
                        <option value="">Select city</option>
                        <option value="Cairo">Cairo</option>
                        <option value="Assiut">Assiut</option>
                        <option value="Alexandria">Alexandria</option>
                        <option value="Giza">Giza</option>
                        <option value="Dakahlia">Dakahlia</option>
                        <option value="Red Sea">Red Sea</option>
                        <option value="Beheira">Beheira</option>
                    </select>
                </div>
                <div class="filter-item">
                    <label for="age">Age:</label>
                    <select id="age">
                        <option value="">Select Age Range</option>
                        <option value="18-20">18-20</option>
                        <option value="20-25">20-25</option>
                        <option value="25-30">25-30</option>
                        <option value="30-35">30-35</option>
                        <option value="40-45">40-45</option>
                    </select>
                </div>
                <div class="filter-item">
                    <label for="experience">Experience (Years):</label>
                    <select id="experience">
                        <option value="">Select Experience</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="10">10</option>
                        <option value=">10">More than 10</option>
                        <option value=">15">More than 15</option>
                        <option value=">20">More than 20</option>
                    </select>
                </div>


                <div class="filter-item">
                    <label for="job">Job:</label>
                    <select id="job">
                        <option value="">Select Job</option>
                        <option value="UI/UX Designer">UI/UX Designer</option>
                        <option value="Front-End Developer">Front-End Developer</option>
                        <option value="Back-End Developer">Back-End Developer</option>
                        <option value="Software Engineer">Software Engineer</option>
                        <option value="Data Analyst">Data Analyst</option>
                        <option value="Machine Learning Engineer">Machine Learning Engineer</option>
                        <option value="AI Engineer">AI Engineer</option>
                        <option value="Others">Others</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

