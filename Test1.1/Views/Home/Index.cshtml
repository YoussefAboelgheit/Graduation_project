              <div class="filter-item">
                  <label for="job">Field of work:</label>
                  <select id="job">
                      <option value="">Select field of work</option>
                      <option>AI Engineer</option>
                      <option>AR/VR Developer</option>
                      <option>Back‑End Developer</option>
