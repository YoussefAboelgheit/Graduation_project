@model Test1._1.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "SignIn";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Form</title>
    <link rel="stylesheet" href="~/css/stylelogin.css">
</head>

<body>
    <form asp-action="CheckSignIn" asp-controller="Home" method="post" asp-antiforgery="true" class="login-form">
        <h1 class="login-title">Login</h1>
        
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="input-box">
            <input asp-for="Email" class="form-control" placeholder="Email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="input-box">
            <input asp-for="Password" class="form-control" placeholder="Password" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="remember-forgot-box">
            <label for="remember">
                <input type="checkbox" id="remember" asp-for="RememberMe">
                Remember me
            </label>
            <a href="#">Forgot Password?</a>
        </div>

        <button type="submit" class="login-btn">Login</button>

        <p class="register">
            Don't have an account?
            <a asp-controller="Home" asp-action="SignUp">Register</a>
        </p>
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
