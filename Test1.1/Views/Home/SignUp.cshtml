@model Test1._1.Models.ViewModels.SignUpViewModel

@{
    ViewData["Title"] = "SignUp";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
    <link rel="stylesheet" href="~/css/styleSignUp.css">
</head>

<body>
    <div class="container">

        <div class="toggle-container">
            <div class="toggle-button" onclick="toggleCard()">
                <span id="toggle-text">Applicant</span>
            </div>
        </div>

        <div class="card-container">
            <div class="flip-card" id="flip-card">
                <div class="flip-card-inner">

                    <div class="flip-card-front">
                        <h2>Sign Up as Applicant</h2>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <form asp-action="ApplicantSignUp" asp-controller="Home" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input asp-for="Fname" class="form-control" placeholder="First Name" required />
                            <span asp-validation-for="Fname" class="text-danger"></span>

                            <input asp-for="Lname" class="form-control" placeholder="Last Name" required />
                            <span asp-validation-for="Lname" class="text-danger"></span>

                            <input asp-for="Email" type="email" class="form-control" placeholder="Email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>

                            <input asp-for="Password" type="password" class="form-control" placeholder="Password" required />
                            <span asp-validation-for="Password" class="text-danger"></span>

                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                            <input asp-for="Phone" class="form-control" placeholder="Phone Number" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>

                            <input asp-for="Field_work" class="form-control" placeholder="Field of Work" required />
                            <span asp-validation-for="Field_work" class="text-danger"></span>

                            <input asp-for="Address" class="form-control" placeholder="Address" required />
                            <span asp-validation-for="Address" class="text-danger"></span>

                            <label asp-for="Years_experience">Years of Experience:</label>
                            <input asp-for="Years_experience" type="number" min="0" class="form-control" />
                            <span asp-validation-for="Years_experience" class="text-danger"></span>

                            <label asp-for="ProfileImage">Upload Profile Image (Image):</label>
                            <input asp-for="ProfileImage" type="file" accept=".jpeg, .jpg, .png" class="form-control" required />
                            <span asp-validation-for="ProfileImage" class="text-danger"></span>

                            <label asp-for="CVFile">Upload CV (PDF/Image):</label>
                            <input asp-for="CVFile" type="file" accept=".pdf, .jpeg, .jpg, .png" class="form-control" required />
                            <span asp-validation-for="CVFile" class="text-danger"></span>

                            <button type="submit" class="btn btn-primary">Submit</button>
                        </form>

                    </div>

                    <div class="flip-card-back">
                        <h2>Sign Up as Company</h2>
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <form asp-action="CompanySignUp" asp-controller="Home" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input asp-for="UserName" class="form-control" placeholder="User Name" required />
                            <span asp-validation-for="UserName" class="text-danger"></span>

                            <input asp-for="Email" type="email" class="form-control" placeholder="Email" required />
                            <span asp-validation-for="Email" class="text-danger"></span>

                            <input asp-for="Password" type="password" class="form-control" placeholder="Password" required />
                            <span asp-validation-for="Password" class="text-danger"></span>

                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                            <input asp-for="Phone" class="form-control" placeholder="Phone" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>

                            <input asp-for="FiledWork" class="form-control" placeholder="Field of Work" required />
                            <span asp-validation-for="FiledWork" class="text-danger"></span>

                            <input asp-for="Address" class="form-control" placeholder="Address" required />
                            <span asp-validation-for="Address" class="text-danger"></span>

                            <label asp-for="Logo">Upload Company Logo (Image):</label>
                            <input asp-for="Logo" type="file" accept=".jpg, .jpeg, .png" class="form-control" />
                            <span asp-validation-for="Logo" class="text-danger"></span>

                            <label asp-for="TaxCard">Upload Company TaxCard (PDF):</label>
                            <input asp-for="TaxCard" type="file" accept=".pdf" class="form-control" required />
                            <span asp-validation-for="TaxCard" class="text-danger"></span>

                            <label asp-for="CommercialRegister">Upload Company Commercial Register (PDF):</label>
                            <input asp-for="CommercialRegister" type="file" accept=".pdf" class="form-control" required />
                            <span asp-validation-for="CommercialRegister" class="text-danger"></span>

                            <textarea asp-for="Description" class="form-control" placeholder="Description" maxlength="1000"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>

                            <button type="submit" class="btn btn-primary">Sign Up</button>
                        </form>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <script src="~/js/indexSignUp.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>