@model Test1._1.Models.Entity.JobAdvertisment
@{
    ViewData["Title"] = "Job Advertisement Form";
    Layout = null;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var hasApplied = Model.Applications?.Any(a => a.ApplicantId == currentUserId && !a.IsDeleted) ?? false;
    var isCompanyOwner = Model.Company.Id == currentUserId;
    var hasQuestions = Model.Questions != null && Model.Questions.Any();
    var viewMode = Context.Request.Query["viewMode"].FirstOrDefault() == "true";
    var application = hasApplied ? Model.Applications.FirstOrDefault(a => a.ApplicantId == currentUserId) : null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Job Advertisement Form</title>
    <link rel="stylesheet" href="~/css/styleform.css">
    <style>
        .details-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                margin-bottom: 5px;
                font-weight: bold;
                color: white;
            }

            .form-group .value {
                background-color: white;
                border: 1px solid white;
                border-radius: 4px;
                padding: 10px;
                min-height: 40px;
                display: block;
                width: 100%;
                box-sizing: border-box;
                color: black;
                font-size: 16px;
            }

            .form-group textarea.value {
                min-height: 100px;
                resize: vertical;
                font-size: 16px;
            }

            .form-group input.answer-input {
                background-color: white;
                border: 1px solid #ddd;
                border-radius: 4px;
                padding: 10px;
                width: 100%;
                box-sizing: border-box;
                color: black;
                font-size: 16px;
            }

            .form-group textarea.answer-textarea {
                background-color: white;
                border: 1px solid #ddd;
                border-radius: 4px;
                padding: 10px;
                width: 100%;
                min-height: 80px;
                box-sizing: border-box;
                color: black;
                font-size: 16px;
                resize: vertical;
            }

        .questions-section {
            margin-top: 30px;
            padding: 20px;
            background-color: rgba(248, 249, 250, 0.1);
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

            .questions-section h3 {
                margin-bottom: 15px;
                color: white;
            }

        .question-item {
            margin-bottom: 20px;
            padding: 15px;
            background-color: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .question-text {
            color: white;
            font-weight: bold;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .back-btn {
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
            cursor: pointer;
        }

            .back-btn:hover {
                background-color: #0056b3;
            }

        .submit-btn {
            background-color: #28a745;
            color: white;
            padding: 12px 30px;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 20px;
        }

            .submit-btn:hover {
                background-color: #218838;
            }

            .submit-btn:disabled {
                background-color: #6c757d;
                cursor: not-allowed;
            }

        .already-applied {
            background-color: rgba(40, 167, 69, 0.1);
            border: 1px solid #28a745;
            border-radius: 4px;
            padding: 15px;
            text-align: center;
            color: #28a745;
            margin-top: 20px;
        }

        .answer-input {
            width: 100%;
            padding: 10px;
            margin: 8px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
            font-size: 16px;
            background-color: white;
            color: black;
        }

        /* Question styling */
        .question-text {
            font-weight: bold;
            color: white;
            margin-bottom: 5px;
        }

        /* Divider between questions */
        .question-divider {
            border: none;
            height: 1px;
            background-color: #ccc;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="details-container">
        <div class="container">
            <h2>@Model.Company.UserName Advertisement Form</h2>
            <br />

            @if (hasApplied && !isCompanyOwner && hasQuestions)
            {
                <div class="questions-section">
                    <h3>Your Application Answers:</h3>

                    @foreach (var question in Model.Questions)
                    {
                        var answer = application?.Answers.FirstOrDefault(a => a.QuestionId == question.Id);
                        <div class="question-item">
                            <div class="question-text">@question.Text</div>
                            <div class="existing-answer">
                                Your answer: @(answer?.Response ?? "No answer provided")
                            </div>
                        </div>
                    }
                </div>

                <div class="already-applied">
                    <h3>You have already applied to this position</h3>
                    <p>Thank you for your interest. Your application has been submitted successfully.</p>
                </div>
            }
            else if (hasApplied && !isCompanyOwner)
            {
                <div class="already-applied">
                    <h3>You have already applied to this position</h3>
                    <p>Thank you for your interest. Your application has been submitted successfully.</p>
                </div>
            }
            else
            {
                @if (User.IsInRole("Company"))
                {
                    <div class="form-group">
                        <label>Field of Work:</label>
                        <div class="value">@Model.jobtitle</div>
                    </div>

                    <div class="form-group">
                        <label>Salary Range:</label>
                        <div class="value">@Model.salary</div>
                    </div>

                    <div class="form-group">
                        <label>City:</label>
                        <div class="value">@Model.governorate</div>
                    </div>

                    <div class="form-group">
                        <label>Job Time:</label>
                        <div class="value">@Model.Job_time</div>
                    </div>

                    <div class="form-group">
                        <label>Job Requirements:</label>
                        <textarea class="value" readonly>@Model.JobRequirements</textarea>
                    </div>

                    <div class="form-group">
                        <label>Job Description:</label>
                        <textarea class="value" readonly>@Model.Jobdetail</textarea>
                    </div>
                }
                
                @if (!isCompanyOwner && hasQuestions)
                {
                    <form asp-controller="JobAdvertisement" asp-action="SubmitApplication" method="post">
                        <input type="hidden" name="jobId" value="@Model.Id" />

                        <div class="questions-section">
                            @foreach (var question in Model.Questions)
                            {
                                <div class="question-item">
                                    <div class="question-text">@question.Text</div>

                                    <input type="text" name="answers[@question.Id]" class="answer-input"
                                           placeholder="Please enter your answer here..." required />
                                </div>
                            }

                            @if (!viewMode)
                            {
                                <button type="submit" class="submit-btn">Submit Application</button>
                            }
                        </div>

                        @Html.AntiForgeryToken()
                    </form>
                }
                else if (isCompanyOwner && hasQuestions)
                {
                    <div class="questions-section">
                        <h3>Your Custom Questions:</h3>

                        @foreach (var question in Model.Questions)
                        {
                            <div class="question-item">
                                <div class="question-text">@question.Text</div>
                            </div>
                        }
                    </div>
                }
                else if (!isCompanyOwner && !hasQuestions)
                {
                    <div class="questions-section">
                        <h3>Ready to Apply?</h3>
                        <p style="color: white;">This position doesn't require additional questions. Click the button below to submit your application.</p>

                        <form asp-controller="JobAdvertisement" asp-action="SubmitApplication" method="post">
                            <input type="hidden" name="jobId" value="@Model.Id" />
                            <button type="submit" class="submit-btn">Submit Application</button>
                            @Html.AntiForgeryToken()
                        </form>
                    </div>
                }
            }
        </div>
    </div>
</body>
</html>