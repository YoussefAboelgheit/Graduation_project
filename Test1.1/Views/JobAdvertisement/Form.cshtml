@model Test1._1.Models.Entity.JobAdvertisment
@{
    ViewData["Title"] = "Job Advertisement Form";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Job Advertisement Details</title>
    <link rel="stylesheet" href="~/css/styleform.css">
    <style>
        .details-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
            color: white;
        }
        .form-group .value {
            background-color: white;
            border: 1px solid white;
            border-radius: 4px;
            padding: 10px;
            min-height: 40px;
            display: block;
            width: 100%;
            box-sizing: border-box;
            color: black;
            font-size: 16px;
        }
        .form-group textarea.value {
            min-height: 100px;
            resize: vertical;
            font-size: 16px;
        }
        .questions-section {
            margin-top: 30px;
            padding: 20px;
            background-color: #f8f9fa;
            border-radius: 8px;
        }
        .questions-section h3 {
            margin-bottom: 15px;
            color: #333;
        }
        .back-btn {
            background-color: #007bff;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
        }
        .back-btn:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="details-container">
        @*<a href="@Url.Action("Index", "CompanyInfo", new { id = Model.CompanyId })" class="back-btn">← Back to Company Profile</a>
        *@
        <div class="container">
            <h2>Job Advertisement Details</h2>
            <br />
            <div class="form-group">
                <label>Field of Work:</label>
                <div class="value">@Model.jobtitle</div>
            </div>

            <div class="form-group">
                <label>Salary Range:</label>
                <div class="value">@Model.salary</div>
            </div>

            <div class="form-group">
                <label>City:</label>
                <div class="value">@Model.governorate</div>
            </div>

            <div class="form-group">
                <label>Job Time:</label>
                <div class="value">@Model.Job_time</div>
            </div>

            <div class="form-group">
                <label>Job Requirements:</label>
                <textarea class="value" readonly>@Model.JobRequirements</textarea>
            </div>

            <div class="form-group">
                <label>Job Description:</label>
                <textarea class="value" readonly>@Model.Jobdetail</textarea>
            </div>

            <div class="form-group">
                <label>Posted Date:</label>
                <div class="value">@Model.CreatedDate.ToString("dd/MM/yyyy")</div>
            </div>

            @if (Model.Questions != null && Model.Questions.Any())
            {
                <div class="form-group">
                    <h3>Custom Questions:</h3> <br>
                    @foreach (var question in Model.Questions)
                    {
                        <div class="form-group">
                            <div class="value">@question.Text</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</body>
</html>